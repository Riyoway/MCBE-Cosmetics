{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.cape": {
      "rebuild_animation_matrices": true,
      "geometry": "geometry.custom",
      "materials": [
        {
          "*": "material.cape"
        }
      ],
      "arrays": {
        "textures": {
          "array.frames": [
            "texture.frameb1",
            "texture.frameb2",
            "texture.frameb3",
            "texture.frameb4"
          ]
        }
      },
      "textures": [
        "array.frames[math.mod(math.floor(query.life_time * 7), 4)]"
      ]
    }
  }
}